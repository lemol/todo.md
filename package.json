{
  "name": "@lemol/todo-md",
  "version": "0.2.0",
  "private": true,
  "description": "todo.md: a standard for Markdown task lists, its file-system implementation and the `todo` CLI",
  "bin": {
    "todo": "./dist/bin.js"
  },
  "type": "module",
  "exports": {
    "./spec": "./src/spec/index.ts",
    "./spec/testing": "./src/spec/testing.ts",
    "./markdown": "./src/markdown/index.ts",
    "./core": "./src/core/index.ts",
    "./fs": "./src/fs/index.ts",
    "./hub": "./src/hub/index.ts",
    "./hub/testing": "./src/hub/testing.ts",
    "./git": "./src/git/index.ts",
    "./jira": "./src/jira/index.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "build:cli": "bun scripts/build-cli.ts",
    "prepare": "bun run build:cli",
    "lint": "oxfmt --check && oxlint",
    "fix": "oxlint --fix && oxfmt",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:boundaries": "bun test test/boundaries.test.ts",
    "todo": "bun ./src/cli/bin.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@lemol/ui": "git+ssh://git@github.com/lemol/ui.git#ui@0.3.1",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-hast": "^13.2.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "remix": "3.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "effect": "4.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  }
}
