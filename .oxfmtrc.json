{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [".agents", ".claude", "todo", "**/*.md", "**/*.yaml", "**/*.yml"],
  "sortImports": {
    "newlinesBetween": false
  }
}
